# Public (browser) — must be reachable from the user's machine
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Site URL used for share links, sitemap, and Open Graph (defaults to current origin in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console site verification (optional — paste the content value from Google)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Social media profile links (shown in header/footer when set)
# NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@thestrengthlab
# NEXT_PUBLIC_SOCIAL_TWITCH=https://twitch.tv/thestrengthlab
# NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/thestrengthlab
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/thestrengthlab

# Contact mailboxes (shown in Contact us picker before opening the mail client)
# NEXT_PUBLIC_CONTACT_EMAIL=strengthlabsupport@gmail.com
# NEXT_PUBLIC_CONTACT_EMAIL_SECONDARY=thestrengthlab@proton.me

# Optional: server-side API base when Next proxies/fetches from inside Docker
# API_INTERNAL_URL=http://api:8080

# Northflank / custom domain (thestrengthlab.biz):
# API_INTERNAL_URL=https://p01--the-strength-lab-backend--ksz6myg7fqzk.code.run
# NEXT_PUBLIC_API_URL=https://www.thestrengthlab.biz
# NEXT_PUBLIC_WS_URL=wss://p01--the-strength-lab-backend--ksz6myg7fqzk.code.run
# NEXT_PUBLIC_SITE_URL=https://www.thestrengthlab.biz
# API_PROXY=true
