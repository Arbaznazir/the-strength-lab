# Public (browser) — must be reachable from the user's machine
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Site URL used for share links (defaults to current origin in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social media profile links (shown in header/footer when set)
# NEXT_PUBLIC_SOCIAL_TWITTER=https://x.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/thestrengthlab
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@thestrengthlab
# NEXT_PUBLIC_SOCIAL_TWITCH=https://twitch.tv/thestrengthlab
# NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/thestrengthlab
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/thestrengthlab

# Contact mailbox (opens the user's email client)
# NEXT_PUBLIC_CONTACT_EMAIL=contact@thestrengthlab.com

# Optional: server-side API base when Next proxies/fetches from inside Docker
# API_INTERNAL_URL=http://api:8080
