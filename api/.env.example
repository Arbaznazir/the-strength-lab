# API
API_ADDR=:8080
APP_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_TTL_HOURS=168
CORS_ORIGIN=http://localhost:3000

# Docker Compose: host.docker.internal → local Postgres on your machine
# Native host run (no Docker): use localhost instead of host.docker.internal
DATABASE_URL=postgres://strengthlab:strengthlab@host.docker.internal:5432/strengthlab?sslmode=disable

# Docker Compose: redis is the service name. Native host run: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

SEED_ON_BOOT=true
SEED_BULK=true
