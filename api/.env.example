# API
API_ADDR=:8080
APP_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_TTL_HOURS=168
CORS_ORIGIN=http://localhost:3000

# Database (use service name `postgres` inside Docker Compose)
DATABASE_URL=postgres://strengthlab:strengthlab@postgres:5432/strengthlab?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Seed demo data on boot (true/false)
SEED_ON_BOOT=true
